# MongoDB
MONGODB_URL=
DB_NAME=cluster0
# Set to "false" to skip automatic index creation on boot and instead run
# `npm run db:indexes` as a deploy/setup step (recommended for production).
DB_AUTO_INDEX=

# Auth (JWT HS256 signing key)
SECRET_KEY=

# Set to "true" only behind HTTPS (production). Leave unset on local HTTP.
COOKIE_SECURE=

# SMTP (server-only, never exposed to the browser)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
MAIL_FROM=

# Public (safe to expose to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Paystack public/publishable key (pk_test_ / pk_live_). Optional for hosted
# redirect checkout; still used as a Docker build arg.
NEXT_PUBLIC_PAYSTACK_KEY=

# Payments (server-only). Charge in the tournament currency - no FX on Gamelyd.
# Stripe: USD, GBP, EUR. Paystack: NGN, GHS, KES, ZAR.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
# Webhook URLs (must be publicly reachable in live/test):
#   Stripe   POST {NEXT_PUBLIC_APP_URL}/api/payments/stripe/webhook
#   Paystack POST {NEXT_PUBLIC_APP_URL}/api/payments/paystack/webhook
# Paystack also returns players to:
#   GET {NEXT_PUBLIC_APP_URL}/api/payments/paystack/callback

# --- Whisperly (desktop app) API: /api/whisperly/* -------------------------
# A separate module with its own whisperly_* collections, users and tokens.
# It shares only the MongoDB server (MONGODB_URL) and SMTP server (SMTP_*).
# Required: random 64+ chars (openssl rand -base64 48). Signs Whisperly tokens only.
WHISPERLY_SECRET_KEY=
# Optional: a separate Mongo database for the whisperly_* collections (default: DB_NAME).
WHISPERLY_DB_NAME=
# Sender for Whisperly emails (welcome, reset codes, access granted).
WHISPERLY_MAIL_FROM="Whisperly <no-reply@gamelyd.com>"
# Optional: emailed when a new account is waiting for approval.
WHISPERLY_ADMIN_NOTIFY_EMAIL=
# Optional: comma-separated emails that are always admin (and approved). Applied
# when that account signs in or checks its licence. Sign up with it yourself first.
WHISPERLY_ADMIN_EMAILS=
# Older app builds get "update required" (HTTP 426).
WHISPERLY_MIN_APP_VERSION=0.3.0
# Self-service "move account to this Mac" is allowed once every N days (admin reset always works).
WHISPERLY_MOVE_COOLDOWN_DAYS=30
# Public base URL of this API (used for Stripe return pages). Default: NEXT_PUBLIC_APP_URL.
WHISPERLY_PUBLIC_URL=
# Payments are built but switched off. Billing routes return 503 until this is "true".
WHISPERLY_PAYMENTS_ENABLED=false
WHISPERLY_STRIPE_SECRET_KEY=
WHISPERLY_STRIPE_PRICE_ID=
WHISPERLY_STRIPE_WEBHOOK_SECRET=
# Stripe webhook URL (when enabled): POST {WHISPERLY_PUBLIC_URL}/api/whisperly/billing/webhook

# --- scripts/upload-game-images.ts (npm run catalog:upload) only -------------
# Usually passed on the command line instead of stored here.
# ADMIN_PASSWORD=
# CATALOG_DIR=
# CATALOG_BASE_URL=
